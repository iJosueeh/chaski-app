# ==============================================================================
# CHASKI - Plantilla de Variables de Entorno (.env.template)
# ==============================================================================
# Copia este archivo a `.env` (o `.env.local`):
#   copy .env.template .env
#
# EQUIVALENCIA DE API KEYS EN SUPABASE:
# - Legacy `anon key`        -> Nueva `Publishable key` (prefijo `sb_publishable_...`)
# - Legacy `service_role key` -> Nueva `Secret key`     (prefijo `sb_secret_...`)
#
# IMPORTANTE:
# En esta aplicación móvil (cliente), debes colocar ÚNICAMENTE la clave pública
# (la nueva `Publishable key` o la `anon key` legacy). Ambas son 100% compatibles.
#
# NUNCA uses la `Secret key` (antigua `service_role`) aquí: esa clave tiene
# privilegios totales de administrador y omite las políticas de seguridad (RLS).
# ==============================================================================

# URL de tu proyecto Supabase (Dashboard > Settings > API Keys > Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública: pega aquí tu 'Publishable key' (sb_publishable_...) o 'anon key' (legacy JWT)
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_o_legacy_anon_key_aqui