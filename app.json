{
  "expo": {
    "name": "chaski",
    "slug": "chaski",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chaski",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.chaski.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser",
      "react-native-maps",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chaski usa tus fotos para la imagen de perfil y para las fotos de los destinos del catalogo.",
          "cameraPermission": "Chaski usa la camara para tomar tu foto de perfil y fotografias de los destinos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chaski usa tu ubicacion para avisarte cuando estas cerca de una parada del recorrido."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9C3E1B"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
